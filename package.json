{
  "name": "ai-dev-assistant",
  "version": "0.1.0",
  "description": "Human-in-the-loop autonomous AI coding assistant",
  "type": "module",
  "bin": {
    "ai-dev": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "docker:build": "docker build -t ai-dev-sandbox:latest -f docker/sandbox.Dockerfile .",
    "docker:run": "docker run -it ai-dev-sandbox:latest --env-file .env"
  },
  "packageManager": "yarn@4.11.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "dockerode": "^4.0.9",
    "dotenv": "^17.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}