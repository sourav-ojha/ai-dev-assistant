# === LLM ===
# Provider: anthropic (default) | ollama | mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# For LLM_PROVIDER=ollama (local testing, no API cost)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=123456789

# === Paths ===
WORKSPACE_DIR=/tmp/ai-dev-assistant/workspaces
DB_PATH=./data/tasks.db

# === Budget ===
TOKEN_BUDGET_PER_TASK=50000

# === Docker ===
DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_IMAGE=ai-dev-sandbox:latest
SANDBOX_TIMEOUT_SEC=600
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_COUNT=1

# === Logging ===
LOG_LEVEL=info
# Optional: write JSON logs to file for later analysis (e.g. ./logs/ai-dev-assistant.log)
# LOG_FILE=./logs/ai-dev-assistant.log
GH_TOKEN=
